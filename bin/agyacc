#!/usr/bin/env bash
#
# Antigravity Account Switcher for macOS (agyacc)
# Manage and seamlessly switch between multiple Google Antigravity accounts.
#
# Repository: https://github.com/mak0099/antigravity-account-switcher-macos
# License: MIT

set -euo pipefail

# Configuration
SERVICE="gemini"
ACCOUNT="antigravity"
PROFILES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/antigravity_profiles"
# Fallback to legacy path if it already exists
if [ -d "$HOME/.antigravity_profiles" ] && [ ! -d "$PROFILES_DIR" ]; then
    PROFILES_DIR="$HOME/.antigravity_profiles"
fi

# Styling & Colors
if [ -t 1 ]; then
    BOLD=$'\033[1m'
    GREEN=$'\033[0;32m'
    RED=$'\033[0;31m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    CYAN=$'\033[0;36m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
else
    BOLD="" GREEN="" RED="" YELLOW="" BLUE="" CYAN="" DIM="" RESET=""
fi

# Helpers
log_info()    { printf "%b[INFO]%b %s\n" "${BLUE}" "${RESET}" "$*"; }
log_success() { printf "%b[SUCCESS]%b %s\n" "${GREEN}" "${RESET}" "$*"; }
log_warn()    { printf "%b[WARN]%b %s\n" "${YELLOW}" "${RESET}" "$*"; }
log_error()   { printf "%b[ERROR]%b %s\n" "${RED}" "${RESET}" "$*" >&2; }

ensure_dir() {
    if [ ! -d "$PROFILES_DIR" ]; then
        mkdir -p "$PROFILES_DIR"
        chmod 700 "$PROFILES_DIR"
    fi
}

get_current_token() {
    security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null || true
}

terminate_antigravity() {
    log_info "Closing Antigravity gracefully..."

    # Gracefully terminate Antigravity via AppleScript so child processes (language servers) clean up properly
    osascript -e 'quit app "Antigravity"' 2>/dev/null || killall "Antigravity" 2>/dev/null || true

    # Wait until the main process exits
    local count=0
    while pgrep -x "Antigravity" >/dev/null 2>&1 && [ $count -lt 10 ]; do
        sleep 0.5
        count=$((count + 1))
    done

    # Force quit if still hanging after timeout
    if pgrep -x "Antigravity" >/dev/null 2>&1; then
        killall -9 "Antigravity" 2>/dev/null || true
        sleep 0.5
    fi

    # Buffer for macOS to complete process deregistration
    sleep 1.5
}

launch_antigravity() {
    log_info "Relaunching Antigravity..."
    open -a "/Applications/Antigravity.app" 2>/dev/null || open -a "Antigravity" 2>/dev/null || {
        log_warn "Could not automatically launch Antigravity. Please open it manually from Applications."
    }
}

# Commands
cmd_save() {
    local profile_name="${1:-}"
    if [ -z "$profile_name" ]; then
        log_error "Missing profile name."
        printf "Usage: %bagyacc save <profile_name>%b\n" "${BOLD}" "${RESET}"
        exit 1
    fi

    ensure_dir
    local token
    token="$(get_current_token)"

    if [ -z "$token" ]; then
        log_error "No active Antigravity session found in macOS Keychain."
        log_info "Please log in to Antigravity first before saving."
        exit 1
    fi

    local target_file="$PROFILES_DIR/$profile_name"
    if [ -f "$target_file" ]; then
        read -rp "Profile '$profile_name' already exists. Overwrite? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            log_info "Operation cancelled."
            exit 0
        fi
    fi

    echo "$token" > "$target_file"
    chmod 600 "$target_file"
    log_success "Session successfully saved as: ${BOLD}$profile_name${RESET}"
}

cmd_switch() {
    local profile_name="${1:-}"
    if [ -z "$profile_name" ]; then
        log_error "Missing profile name."
        printf "Usage: %bagyacc <profile_name>%b or %bagyacc switch <profile_name>%b\n" "${BOLD}" "${RESET}" "${BOLD}" "${RESET}"
        exit 1
    fi

    local target_file="$PROFILES_DIR/$profile_name"
    if [ ! -f "$target_file" ]; then
        log_error "Profile '${BOLD}$profile_name${RESET}' does not exist."
        log_info "To save your current session as '$profile_name', run: agyacc save $profile_name"
        echo ""
        cmd_list
        exit 1
    fi

    local token
    token="$(cat "$target_file")"

    terminate_antigravity

    log_info "Updating Keychain credentials for: ${BOLD}$profile_name${RESET}..."
    security add-generic-password -U -s "$SERVICE" -a "$ACCOUNT" -w "$token" 2>/dev/null

    launch_antigravity
    log_success "Switched to: ${BOLD}$profile_name${RESET}"
}

cmd_new() {
    read -rp "This will log out the current session and prepare for a new login. Continue? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log_info "Operation cancelled."
        exit 0
    fi

    terminate_antigravity

    log_info "Clearing Keychain credentials..."
    security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" 2>/dev/null || true

    launch_antigravity
    log_success "Session reset complete."
    printf "👉 Log in to Antigravity, then save this profile: %bagyacc save <name>%b\n" "${BOLD}" "${RESET}"
}

cmd_list() {
    ensure_dir
    local current_token
    current_token="$(get_current_token)"

    local profiles
    profiles=$(find "$PROFILES_DIR" -maxdepth 1 -type f ! -name ".*" -exec basename {} \; 2>/dev/null | sort || true)

    if [ -z "$profiles" ]; then
        log_warn "No saved profiles found in $PROFILES_DIR"
        printf "Save your current session with: %bagyacc save <name>%b\n" "${BOLD}" "${RESET}"
        return 0
    fi

    printf "%bAvailable Profiles:%b\n" "${BOLD}" "${RESET}"
    printf "%b----------------------------------------%b\n" "${DIM}" "${RESET}"

    while IFS= read -r profile; do
        local profile_token
        profile_token="$(cat "$PROFILES_DIR/$profile" 2>/dev/null || true)"
        if [ -n "$current_token" ] && [ "$profile_token" = "$current_token" ]; then
            printf "  %b● %b%s%b %b(active)%b\n" "${GREEN}" "${BOLD}" "$profile" "${RESET}" "${CYAN}" "${RESET}"
        else
            printf "    %s\n" "$profile"
        fi
    done <<< "$profiles"

    printf "%b----------------------------------------%b\n" "${DIM}" "${RESET}"
}

cmd_status() {
    local current_token
    current_token="$(get_current_token)"

    if [ -z "$current_token" ]; then
        log_warn "No active Antigravity session found in Keychain."
        return 0
    fi

    ensure_dir
    local matched_profile=""
    for file in "$PROFILES_DIR"/*; do
        [ -f "$file" ] || continue
        if [ "$(cat "$file" 2>/dev/null)" = "$current_token" ]; then
            matched_profile="$(basename "$file")"
            break
        fi
    done

    printf "%bCurrent Session Status:%b\n" "${BOLD}" "${RESET}"
    if [ -n "$matched_profile" ]; then
        printf "  Active Profile : %b%b%s%b\n" "${GREEN}" "${BOLD}" "$matched_profile" "${RESET}"
    else
        printf "  Active Profile : %bUnsaved Session%b (Run 'agyacc save <name>' to save)\n" "${YELLOW}" "${RESET}"
    fi
}

cmd_delete() {
    local profile_name="${1:-}"
    if [ -z "$profile_name" ]; then
        log_error "Missing profile name."
        printf "Usage: %bagyacc rm <profile_name>%b\n" "${BOLD}" "${RESET}"
        exit 1
    fi

    local target_file="$PROFILES_DIR/$profile_name"
    if [ ! -f "$target_file" ]; then
        log_error "Profile '$profile_name' not found."
        exit 1
    fi

    read -rp "Are you sure you want to delete profile '$profile_name'? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -f "$target_file"
        log_success "Profile '$profile_name' deleted."
    else
        log_info "Operation cancelled."
    fi
}

cmd_rename() {
    local old_name="${1:-}"
    local new_name="${2:-}"

    if [ -z "$old_name" ] || [ -z "$new_name" ]; then
        log_error "Usage: agyacc rename <old_name> <new_name>"
        exit 1
    fi

    local old_file="$PROFILES_DIR/$old_name"
    local new_file="$PROFILES_DIR/$new_name"

    if [ ! -f "$old_file" ]; then
        log_error "Profile '$old_name' does not exist."
        exit 1
    fi

    if [ -f "$new_file" ]; then
        log_error "Profile '$new_name' already exists."
        exit 1
    fi

    mv "$old_file" "$new_file"
    log_success "Renamed profile '$old_name' to '$new_name'."
}

cmd_version() {
    printf "%bagyacc%b version %b1.0.0%b (macOS)\n" "${BOLD}" "${RESET}" "${GREEN}" "${RESET}"
}

cmd_help() {
    cat << EOF
${BOLD}Antigravity Account Switcher for macOS (agyacc)${RESET}

${BOLD}USAGE:${RESET}
  ${GREEN}agyacc <profile>${RESET}         Directly switch to a profile (e.g. ${CYAN}agyacc personal${RESET}, ${CYAN}agyacc work${RESET})

${BOLD}COMMANDS:${RESET}
  ${GREEN}agyacc${RESET}                   Show profile list and current active status
  ${GREEN}agyacc save <name>${RESET}     Save current login session under a profile name
  ${GREEN}agyacc switch <name>${RESET}   Switch to an existing saved profile
  ${GREEN}agyacc new${RESET}               Clear session to log in with a new account
  ${GREEN}agyacc rm <name>${RESET}        Delete a saved profile
  ${GREEN}agyacc rename <old> <new>${RESET} Rename a saved profile
  ${GREEN}agyacc status${RESET}            Show currently active profile
  ${GREEN}agyacc version${RESET}           Show version information
  ${GREEN}agyacc help${RESET}              Show this help menu

${BOLD}WORKFLOW:${RESET}
  1. Login to your 1st account in Antigravity.
  2. Run: ${CYAN}agyacc save work${RESET}
  3. Run: ${CYAN}agyacc new${RESET} (Logs out session & restarts Antigravity).
  4. Login to your 2nd account in Antigravity.
  5. Run: ${CYAN}agyacc save personal${RESET}
  6. Switch anytime without browser visits: ${CYAN}agyacc work${RESET} or ${CYAN}agyacc personal${RESET}
EOF
}

# Entrypoint
if [ $# -eq 0 ]; then
    cmd_list
    echo ""
    cmd_status
    exit 0
fi

COMMAND="$1"
shift || true

case "$COMMAND" in
    save)             cmd_save "$@" ;;
    switch)           cmd_switch "$@" ;;
    list|ls)          cmd_list "$@" ;;
    status)           cmd_status "$@" ;;
    new|logout)       cmd_new "$@" ;;
    delete|rm)        cmd_delete "$@" ;;
    rename)           cmd_rename "$@" ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help)   cmd_help ;;
    *)
        # If argument matches a profile or anything else, attempt direct switch
        cmd_switch "$COMMAND" "$@"
        ;;
esac
