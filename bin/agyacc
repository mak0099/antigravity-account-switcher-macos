#!/usr/bin/env bash
#
# Antigravity Account Switcher for macOS (agyacc)
# Manage and seamlessly switch between multiple Google Antigravity accounts.
#
# Repository: https://github.com/mak0099/antigravity-account-switcher-macos
# License: MIT

set -euo pipefail

VERSION="1.1.0"

# Configuration
SERVICE="gemini"
ACCOUNT="antigravity"
PROFILES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/antigravity_profiles"
# Fallback to legacy path if it already exists
if [ -d "$HOME/.antigravity_profiles" ] && [ ! -d "$PROFILES_DIR" ]; then
    PROFILES_DIR="$HOME/.antigravity_profiles"
fi

# Styling & Colors (ANSI-C Quoted)
if [ -t 1 ]; then
    BOLD=$'\033[1m'
    GREEN=$'\033[0;32m'
    RED=$'\033[0;31m'
    YELLOW=$'\033[0;33m'
    BLUE=$'\033[0;34m'
    CYAN=$'\033[0;36m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
else
    BOLD="" GREEN="" RED="" YELLOW="" BLUE="" CYAN="" DIM="" RESET=""
fi

# Helpers
log_info()    { printf "%b[INFO]%b %s\n" "${BLUE}" "${RESET}" "$*"; }
log_success() { printf "%b[SUCCESS]%b %s\n" "${GREEN}" "${RESET}" "$*"; }
log_warn()    { printf "%b[WARN]%b %s\n" "${YELLOW}" "${RESET}" "$*"; }
log_error()   { printf "%b[ERROR]%b %s\n" "${RED}" "${RESET}" "$*" >&2; }

ensure_dir() {
    if [ ! -d "$PROFILES_DIR" ]; then
        mkdir -p "$PROFILES_DIR"
        chmod 700 "$PROFILES_DIR"
    fi
}

get_current_token() {
    security find-generic-password -s "$SERVICE" -a "$ACCOUNT" -w 2>/dev/null || true
}

terminate_antigravity() {
    log_info "Closing Antigravity gracefully..."

    # Gracefully terminate via AppleScript or kill signals targeting the current user
    osascript -e 'tell application "Antigravity" to quit' 2>/dev/null || pkill -u "$UID" -f "Antigravity" 2>/dev/null || true
    pkill -u "$UID" -f "language_server" 2>/dev/null || true

    # Wait until current user's processes have completely exited
    local count=0
    while pgrep -u "$UID" -f "Antigravity.app/Contents/MacOS/Antigravity" >/dev/null 2>&1 && [ $count -lt 10 ]; do
        sleep 0.5
        count=$((count + 1))
    done

    # Force quit if still hanging
    if pgrep -u "$UID" -f "Antigravity.app/Contents/MacOS/Antigravity" >/dev/null 2>&1; then
        pkill -9 -u "$UID" -f "Antigravity" 2>/dev/null || true
        sleep 0.5
    fi

    # Extra buffer for macOS LaunchServices to complete process deregistration
    sleep 1.5
}

launch_antigravity() {
    log_info "Relaunching Antigravity..."
    open -a "/Applications/Antigravity.app" 2>/dev/null || open -a "Antigravity" 2>/dev/null || {
        log_warn "Could not automatically launch Antigravity. Please open it manually from Applications."
    }
}

resolve_profile() {
    local query="$1"

    # Direct file match
    if [ -f "$PROFILES_DIR/$query" ]; then
        echo "$query"
        return 0
    fi

    # Smart match via python (email, email prefix, case-insensitive profile name)
    local match
    match=$(/usr/bin/python3 - "$PROFILES_DIR" "$query" 2>/dev/null << 'PYEOF'
import sys, os, json, base64

profiles_dir = sys.argv[1]
query = sys.argv[2].strip().lower()

def extract_email(path):
    try:
        with open(path) as f:
            raw = f.read().strip()
        if raw.startswith("go-keyring-base64:"):
            raw = raw[18:]
        data = json.loads(base64.b64decode(raw).decode("utf-8", "ignore"))
        idt = data.get("id_token", "")
        if idt and "." in idt:
            payload = idt.split(".")[1] + "=="
            claims = json.loads(base64.urlsafe_b64decode(payload).decode("utf-8", "ignore"))
            return claims.get("email", "").lower()
    except Exception:
        pass
    return ""

files = [f for f in os.listdir(profiles_dir) if not f.startswith(".") and os.path.isfile(os.path.join(profiles_dir, f))]

# Case-insensitive filename match
for f in files:
    if f.lower() == query:
        print(f)
        sys.exit(0)

# Email or email-prefix match
matches = []
for f in files:
    email = extract_email(os.path.join(profiles_dir, f))
    if not email:
        continue
    prefix = email.split("@")[0]
    if query == email or query == prefix:
        matches.append(f)

if len(matches) == 1:
    print(matches[0])
    sys.exit(0)
elif len(matches) > 1:
    sys.exit(2)
else:
    sys.exit(1)
PYEOF
    ) || true

    if [ -n "$match" ]; then
        echo "$match"
        return 0
    fi

    return 1
}

# Commands
cmd_save() {
    local profile_name="${1:-}"
    if [ -z "$profile_name" ]; then
        log_error "Missing profile name."
        printf "Usage: %bagyacc save <profile_name>%b\n" "${BOLD}" "${RESET}"
        exit 1
    fi

    ensure_dir
    local token
    token="$(get_current_token)"

    # Fallback: if Keychain is empty, check ~/.gemini/jetski-standalone-oauth-token
    if [ -z "$token" ] && [ -f "$HOME/.gemini/jetski-standalone-oauth-token" ]; then
        local b64
        b64=$(base64 < "$HOME/.gemini/jetski-standalone-oauth-token" | tr -d '\n')
        if [ -n "$b64" ]; then
            token="go-keyring-base64:$b64"
        fi
    fi

    if [ -z "$token" ]; then
        log_error "No active Antigravity session found in macOS Keychain or disk."
        log_info "Please log in to Antigravity first before saving."
        exit 1
    fi

    local target_file="$PROFILES_DIR/$profile_name"
    if [ -f "$target_file" ]; then
        read -rp "Profile '$profile_name' already exists. Overwrite? [y/N]: " confirm
        if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
            log_info "Operation cancelled."
            exit 0
        fi
    fi

    echo "$token" > "$target_file"
    echo "$profile_name" > "$PROFILES_DIR/.active" 2>/dev/null || true
    chmod 600 "$target_file"
    log_success "Session successfully saved as: ${BOLD}$profile_name${RESET}"
}

cmd_switch() {
    local input="${1:-}"
    if [ -z "$input" ]; then
        log_error "Missing profile name or email."
        printf "Usage: %bagyacc <name|email>%b or %bagyacc switch <name|email>%b\n" "${BOLD}" "${RESET}" "${BOLD}" "${RESET}"
        exit 1
    fi

    local profile_name
    if ! profile_name="$(resolve_profile "$input")"; then
        log_error "Profile or email '${BOLD}$input${RESET}' not found."
        log_info "To save your current session as '$input', run: agyacc save $input"
        echo ""
        cmd_list
        exit 1
    fi

    local target_file="$PROFILES_DIR/$profile_name"
    local token
    token="$(cat "$target_file")"

    terminate_antigravity

    log_info "Updating Keychain credentials for: ${BOLD}$profile_name${RESET}..."
    security add-generic-password -U -s "$SERVICE" -a "$ACCOUNT" -w "$token" 2>/dev/null

    # Sync on-disk token file so language_server and Electron don't fall back to old session
    if [[ "$token" == go-keyring-base64:* ]]; then
        local b64="${token#go-keyring-base64:}"
        mkdir -p "$HOME/.gemini"
        printf "%s" "$b64" | (base64 -D 2>/dev/null || base64 --decode 2>/dev/null || base64 -d 2>/dev/null) > "$HOME/.gemini/jetski-standalone-oauth-token" 2>/dev/null || true
        chmod 600 "$HOME/.gemini/jetski-standalone-oauth-token" 2>/dev/null || true
    fi

    echo "$profile_name" > "$PROFILES_DIR/.active" 2>/dev/null || true
    launch_antigravity
    log_success "Switched to: ${BOLD}$profile_name${RESET}"
}

cmd_new() {
    read -rp "This will log out the current session and prepare for a new login. Continue? [y/N]: " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log_info "Operation cancelled."
        exit 0
    fi

    terminate_antigravity

    log_info "Clearing Keychain credentials..."
    security delete-generic-password -s "$SERVICE" -a "$ACCOUNT" 2>/dev/null || true

    log_info "Clearing on-disk session tokens..."
    rm -f "$HOME/.gemini/jetski-standalone-oauth-token"
    rm -f "$HOME/.gemini/google_accounts.json"
    rm -f "$HOME/.gemini/oauth_creds.json"
    rm -f "$PROFILES_DIR/.active" 2>/dev/null || true

    launch_antigravity
    log_success "Session reset complete."
    printf "👉 Log in to Antigravity, then save this profile: %bagyacc save <name>%b\n" "${BOLD}" "${RESET}"
}

cmd_list() {
    ensure_dir

    local profiles
    profiles=$(find "$PROFILES_DIR" -maxdepth 1 -type f ! -name ".*" -exec basename {} \; 2>/dev/null | sort || true)

    if [ -z "$profiles" ]; then
        log_warn "No saved profiles found in $PROFILES_DIR"
        printf "Save your current session with: %bagyacc save <name>%b\n" "${BOLD}" "${RESET}"
        return 0
    fi

    printf "%bAvailable Profiles:%b\n" "${BOLD}" "${RESET}"
    printf "%b----------------------------------------%b\n" "${DIM}" "${RESET}"

    /usr/bin/python3 - "$PROFILES_DIR" "$SERVICE" "$ACCOUNT" << 'PYEOF'
import sys, os, json, base64, subprocess

profiles_dir = sys.argv[1]
service = sys.argv[2]
account = sys.argv[3]

def extract_info(raw):
    if not raw: return None
    if raw.startswith("go-keyring-base64:"):
        raw = raw[18:]
    try:
        data = json.loads(base64.b64decode(raw).decode("utf-8", "ignore"))
        email = None
        idt = data.get("id_token", "")
        if idt and "." in idt:
            payload = idt.split(".")[1] + "=="
            claims = json.loads(base64.urlsafe_b64decode(payload).decode("utf-8", "ignore"))
            email = claims.get("email")
        rt = data.get("token", {}).get("refresh_token")
        return {"email": email, "refresh_token": rt}
    except Exception:
        return None

kc_info = None
try:
    token_kc = subprocess.check_output(["security", "find-generic-password", "-s", service, "-a", account, "-w"], stderr=subprocess.DEVNULL).decode().strip()
    kc_info = extract_info(token_kc)
except Exception:
    pass

active_file = os.path.join(profiles_dir, ".active")
last_active = ""
if os.path.exists(active_file):
    with open(active_file) as f:
        last_active = f.read().strip()

files = sorted([f for f in os.listdir(profiles_dir) if not f.startswith(".") and os.path.isfile(os.path.join(profiles_dir, f))])

BOLD = "\033[1m"
GREEN = "\033[0;32m"
CYAN = "\033[0;36m"
DIM = "\033[2m"
RESET = "\033[0m"

for p in files:
    p_path = os.path.join(profiles_dir, p)
    with open(p_path) as f:
        p_raw = f.read().strip()
    p_info = extract_info(p_raw)
    email_str = f" {DIM}({p_info['email']}){RESET}" if (p_info and p_info.get("email")) else ""

    is_active = False
    if kc_info and p_info:
        if (kc_info.get("refresh_token") and kc_info["refresh_token"] == p_info.get("refresh_token")) or \
           (kc_info.get("email") and kc_info["email"] == p_info.get("email")):
            is_active = True
    elif last_active and last_active == p:
        is_active = True

    if is_active:
        print(f"  {GREEN}● {BOLD}{p}{RESET}{email_str} {CYAN}(active){RESET}")
    else:
        print(f"    {p}{email_str}")
PYEOF

    printf "%b----------------------------------------%b\n" "${DIM}" "${RESET}"
}

cmd_status() {
    ensure_dir
    /usr/bin/python3 - "$PROFILES_DIR" "$SERVICE" "$ACCOUNT" << 'PYEOF'
import sys, os, json, base64, subprocess

profiles_dir = sys.argv[1]
service = sys.argv[2]
account = sys.argv[3]

def extract_info(raw):
    if not raw: return None
    if raw.startswith("go-keyring-base64:"):
        raw = raw[18:]
    try:
        data = json.loads(base64.b64decode(raw).decode("utf-8", "ignore"))
        email = None
        idt = data.get("id_token", "")
        if idt and "." in idt:
            payload = idt.split(".")[1] + "=="
            claims = json.loads(base64.urlsafe_b64decode(payload).decode("utf-8", "ignore"))
            email = claims.get("email")
        rt = data.get("token", {}).get("refresh_token")
        return {"email": email, "refresh_token": rt}
    except Exception:
        return None

try:
    token_kc = subprocess.check_output(["security", "find-generic-password", "-s", service, "-a", account, "-w"], stderr=subprocess.DEVNULL).decode().strip()
    kc_info = extract_info(token_kc)
except Exception:
    kc_info = None

BOLD = "\033[1m"
GREEN = "\033[0;32m"
YELLOW = "\033[0;33m"
CYAN = "\033[0;36m"
DIM = "\033[2m"
RESET = "\033[0m"

if not kc_info:
    print(f"{YELLOW}[WARN]{RESET} No active Antigravity session found in Keychain.")
    sys.exit(0)

active_file = os.path.join(profiles_dir, ".active")
last_active = ""
if os.path.exists(active_file):
    with open(active_file) as f:
        last_active = f.read().strip()

matched_profile = ""
files = [f for f in os.listdir(profiles_dir) if not f.startswith(".") and os.path.isfile(os.path.join(profiles_dir, f))]
for p in files:
    with open(os.path.join(profiles_dir, p)) as f:
        p_raw = f.read().strip()
    p_info = extract_info(p_raw)
    if p_info:
        if (kc_info.get("refresh_token") and kc_info["refresh_token"] == p_info.get("refresh_token")) or \
           (kc_info.get("email") and kc_info["email"] == p_info.get("email")):
            matched_profile = p
            break
if not matched_profile and last_active:
    matched_profile = last_active

print(f"{BOLD}Current Session Status:{RESET}")
email_str = f" {DIM}({kc_info['email']}){RESET}" if kc_info.get("email") else ""
if matched_profile:
    print(f"  Active Profile : {GREEN}{BOLD}{matched_profile}{RESET}{email_str}")
else:
    print(f"  Active Profile : {YELLOW}Unsaved Session{RESET}{email_str} (Run 'agyacc save <name>' to save)")
PYEOF
}

cmd_delete() {
    local input="${1:-}"
    if [ -z "$input" ]; then
        log_error "Missing profile name or email."
        printf "Usage: %bagyacc rm <name|email>%b\n" "${BOLD}" "${RESET}"
        exit 1
    fi

    local profile_name
    profile_name="$(resolve_profile "$input" 2>/dev/null || echo "$input")"

    local target_file="$PROFILES_DIR/$profile_name"
    if [ ! -f "$target_file" ]; then
        log_error "Profile or email '$input' not found."
        exit 1
    fi

    read -rp "Are you sure you want to delete profile '$profile_name'? [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        rm -f "$target_file"
        log_success "Profile '$profile_name' deleted."
    else
        log_info "Operation cancelled."
    fi
}

cmd_rename() {
    local old_name="${1:-}"
    local new_name="${2:-}"

    if [ -z "$old_name" ] || [ -z "$new_name" ]; then
        log_error "Usage: agyacc rename <old_name> <new_name>"
        exit 1
    fi

    local old_file="$PROFILES_DIR/$old_name"
    local new_file="$PROFILES_DIR/$new_name"

    if [ ! -f "$old_file" ]; then
        log_error "Profile '$old_name' does not exist."
        exit 1
    fi

    if [ -f "$new_file" ]; then
        log_error "Profile '$new_name' already exists."
        exit 1
    fi

    mv "$old_file" "$new_file"
    log_success "Renamed profile '$old_name' to '$new_name'."
}

cmd_version() {
    echo "agyacc v${VERSION}"
}

cmd_help() {
    cat << EOF
${BOLD}Antigravity Account Switcher for macOS (agyacc) v${VERSION}${RESET}
Seamlessly manage and switch between multiple Antigravity accounts.

${BOLD}FAST SWITCH:${RESET}
  ${GREEN}agyacc <profile|email>${RESET}   Directly switch to a profile by name or email
                               Examples:
                                 ${CYAN}agyacc work${RESET}
                                 ${CYAN}agyacc user@gmail.com${RESET}
                                 ${CYAN}agyacc username${RESET}

${BOLD}COMMANDS:${RESET}
  ${GREEN}agyacc${RESET}                   Show profile list and active status
  ${GREEN}agyacc save <name>${RESET}     Save current session under a profile name
  ${GREEN}agyacc new${RESET}               Clear session to log in with a new account
  ${GREEN}agyacc rm <name|email>${RESET}   Delete a saved profile
  ${GREEN}agyacc status${RESET}            Show currently active profile
  ${GREEN}agyacc rename <old> <new>${RESET} Rename a profile
  ${GREEN}agyacc version${RESET}           Show version
  ${GREEN}agyacc help${RESET}              Show this help menu

${BOLD}EXAMPLES:${RESET}
  agyacc save work              # Save current login as 'work'
  agyacc new                    # Clear and log in to another account
  agyacc save personal          # Save that login as 'personal'
  agyacc work                   # Instantly switch to 'work'
  agyacc personal               # Instantly switch to 'personal'
  agyacc john.doe@gmail.com     # Switch directly by email address
EOF
}

# If called without arguments, show profile list and status
if [ $# -eq 0 ]; then
    cmd_list
    echo ""
    cmd_status
    exit 0
fi

COMMAND="$1"
shift || true

case "$COMMAND" in
    save)             cmd_save "$@" ;;
    switch)           cmd_switch "$@" ;;
    list|ls)          cmd_list "$@" ;;
    status)           cmd_status "$@" ;;
    new|logout)       cmd_new "$@" ;;
    delete|rm)        cmd_delete "$@" ;;
    rename)           cmd_rename "$@" ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help)   cmd_help ;;
    *)
        # If argument matches a profile or anything else, attempt direct switch
        cmd_switch "$COMMAND" "$@"
        ;;
esac
